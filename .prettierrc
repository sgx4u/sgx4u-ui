{
	"bracketSpacing": true,
	"printWidth": 120,
	"singleQuote": true,
	"tabWidth": 4,
	"trailingComma": "all",
	"useTabs": true,

	"plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],

	"importOrder": [
		"^react(.*)$",
		"^next(.*)$",
		"<THIRD_PARTY_MODULES>",
		"<BUILTIN_MODULES>",
		"",
		"^@/.*\\.css$",
		"^[@].*\\.style(\\.[tj]sx?)?$",
		"^[./].*\\.style(\\.[tj]sx?)?$",
		"",
		"^[@].*\\.type(\\.[tj]sx?)?$",
		"^[./].*\\.type(\\.[tj]sx?)?$",
		"^[@].*\\.util(\\.[tj]sx?)?$",
		"^[./].*\\.util(\\.[tj]sx?)?$",
		"^@sgx4u/utils(/.*)?$",
		"^[@].*\\.helper(\\.[tj]sx?)?$",
		"^[./].*\\.helper(\\.[tj]sx?)?$",
		"^[@].*\\.service(\\.[tj]sx?)?$",
		"^[./].*\\.service(\\.[tj]sx?)?$",
		"",
		"^[@].*\\.constant(\\.[tj]sx?)?$",
		"^[./].*\\.constant(\\.[tj]sx?)?$",
		"^@sgx4u/constants(/.*)?$",
		"^[@].*\\.data(\\.[tj]sx?)?$",
		"^[./].*\\.data(\\.[tj]sx?)?$",
		"",
		"^[@].*\\.hook(\\.[tj]sx?)?$",
		"^[./].*\\.hook(\\.[tj]sx?)?$",
		"^[@].*\\.store(\\.[tj]sx?)?$",
		"^[./].*\\.store(\\.[tj]sx?)?$",

		"^[@].*\\.provider(\\.[tj]sx?)?$",
		"^[./].*\\.provider(\\.[tj]sx?)?$",
		"",
		"^@sgx4u/ui",
		"^@/(.*)$",
		"^[./]"
	],

	"tailwindAttributes": [".*ClassName.*"],
	"tailwindFunctions": ["cn", "makeVariants"],
	"tailwindStylesheet": "./packages/sgx4u-ui/globals.css"
}
